/target
/src-tauri/target
/node_modules
/dist

# Generated at build time by tauri-build
/src-tauri/gen/schemas

# Mobile icon sets generated by `tauri icon` (this is a desktop app)
/src-tauri/icons/android
/src-tauri/icons/ios

# Build output bundles
/src-tauri/target/release/bundle

# Native macOS / SwiftPM build output
/apps/macos/.build
/apps/macos/build
/apps/macos/.swiftpm

# Native Windows / .NET build output
/apps/windows/**/bin
/apps/windows/**/obj
/apps/windows/build

**/.DS_Store

# Local agent tooling state (per-developer, not project policy)
.claude/settings.local.json

# Mission secrets
.env
.env.*

# Updater signing private key (generated via `npx tauri signer generate`).
# The public key is embedded in tauri.conf.json; the private key must NEVER
# be committed — it is supplied at build time via TAURI_SIGNING_PRIVATE_KEY.
# The keypair lives at ~/.tauri/sgian.key (outside the repo). These patterns
# guard against accidental copies within the repo tree.
*.key
!*.key.pub
**/sgian.key
# Retain the old key name in the denylist during the Sgian2 → Sgian transition.
**/sgian2.key
__pycache__/

# Reserved placeholder crates build their own target dirs.
crates/*/target/
crates/*/Cargo.lock
