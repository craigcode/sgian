{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sgian",
  "version": "0.1.0",
  "identifier": "dev.sgian.sgiantwo",
  "build": {
    "beforeDevCommand": "npm run frontend:dev",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sgian",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.developer-tools",
    "shortDescription": "A fast native pane manager for agentic terminals",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0",
      "providerShortName": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENERjNBREI3Q0I4Nzc0MEQKUldRTmRJZkx0NjN6ellVbllFamxUS1UzeUNSMG5nVmw5aVU1azdCME9QbldmMEMzWlBtTHFIV3kK",
      "endpoints": ["https://github.com/craigcode/sgian/releases/latest/download/latest.json"]
    }
  }
}
